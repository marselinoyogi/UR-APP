rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Fungsi pembantu pengecekan peran
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isStaff() {
      return isAuthenticated() && (
        getUserRole() in ['petugas', 'teknis', 'admin', 'pimpinan']
      );
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    // Koleksi Pengguna (users)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // Master Aplikasi & Kategori (applications & categories)
    match /applications/{appId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Koleksi Tiket (tickets)
    // Sesuai Dokumen Seksi 13: Pengguna hanya tiket miliknya, petugas/teknis/pimpinan sesuai kewenangan
    match /tickets/{ticketId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isStaff()
      );
      
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      allow update: if isAuthenticated() && (
        isStaff() || (resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId)
      );
      
      allow delete: if isAdmin();
    }

    // Pesan Percakapan (ticket_messages)
    match /ticket_messages/{messageId} {
      allow read: if isAuthenticated() && (
        isStaff() || (
          !resource.data.isInternal && 
          get(/databases/$(database)/documents/tickets/$(resource.data.ticketId)).data.userId == request.auth.uid
        )
      );
      
      allow create: if isAuthenticated();
    }

    // Riwayat Perubahan (ticket_history)
    match /ticket_history/{historyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Riwayat audit tidak boleh diubah
    }

    // Penilaian Layanan (ratings)
    match /ratings/{ratingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
